# ==============================================================================
# Placely — Environment Variables
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Public variables — safe to expose in the browser bundle.
# ------------------------------------------------------------------------------

# Your Appwrite Cloud endpoint (default: https://cloud.appwrite.io/v1)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite project ID (found in Appwrite Console → Settings)
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id-here

# The canonical URL of this application (used for metadata, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Server-only variables — NEVER prefix with NEXT_PUBLIC_.
# These are only accessible on the server (Server Components, Server Actions,
# Route Handlers, and Appwrite Functions).
# ------------------------------------------------------------------------------

# Appwrite server API key with appropriate scopes (least-privilege)
# Found in Appwrite Console → Overview → API Keys
APPWRITE_API_KEY=your-server-api-key-here

# The Appwrite database ID for Placely
# Found in Appwrite Console → Databases
APPWRITE_DATABASE_ID=placely-db

# Optional Appwrite Function IDs for asynchronous workflow execution
APPWRITE_SHORTLISTING_FUNCTION_ID=your-shortlisting-function-id
APPWRITE_NOTIFICATION_FUNCTION_ID=your-notification-function-id

# Email automation provider used by the notification dispatcher function
# Supported values: google_apps_script, log
EMAIL_AUTOMATION_PROVIDER=google_apps_script

# Google Apps Script web app endpoint and shared secret token.
# Keep both server-only; never expose them to the browser.
GOOGLE_APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/your-web-app-id/exec
GOOGLE_APPS_SCRIPT_AUTH_TOKEN=replace-with-a-random-shared-secret
